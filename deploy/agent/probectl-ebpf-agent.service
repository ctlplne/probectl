# probectl-ebpf-agent — hardened systemd unit (U-052).
#
# Capability model (see deploy/agent/README.md for the kernel matrix):
#   kernel >= 5.8: CAP_BPF + CAP_PERFMON (the minimal pair: program/map
#                  loading + raw-tracepoint/uprobe attachment) — preferred.
#                  The L4 flow plane runs on exactly this pair as the non-root
#                  User= below: it attaches as a raw tracepoint, so it reads no
#                  tracefs (ING-23; proven per kernel by TestLiveNonRootL4Attach).
#                  L7 TLS capture under this unit is NOT covered (decision D-63).
#   legacy exception: CAP_SYS_ADMIN only when the runtime probe can still
#                  confirm BTF + BPF ring-buffer support and the platform
#                  cannot grant the split CAP_BPF/CAP_PERFMON pair.
# The agent is observe-only either way (the CI gate forbids enforcing
# program types); it never needs CAP_NET_ADMIN, CAP_SYS_PTRACE or root.
[Unit]
Description=probectl eBPF host agent (observe-only)
Documentation=https://github.com/ctlplne/probectl/blob/main/docs/ebpf-agent.md
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/probectl-ebpf-agent --config /etc/probectl/ebpf-agent.yaml
Restart=on-failure
RestartSec=5s

# --- privilege: minimal capabilities, no root ---
User=probectl-agent
Group=probectl-agent
AmbientCapabilities=CAP_BPF CAP_PERFMON
CapabilityBoundingSet=CAP_BPF CAP_PERFMON
NoNewPrivileges=yes
# BPF maps/ringbuf need locked memory.
LimitMEMLOCK=infinity

# --- resource caps (EBPF-007): host-level counterparts of the chart's ---
# The agent chart's container limits are requests 50m/64Mi, limits 500m/256Mi
# (deploy/helm/probectl-agent/values.yaml); these systemd caps are deliberately
# looser whole-unit ceilings for bare-metal hosts. Either way the principle
# holds: a host agent must never starve the workloads it observes.
CPUQuota=100%
CPUWeight=100
MemoryHigh=384M
MemoryMax=512M
TasksMax=128
IOWeight=100

# --- syscall filter (mirror of deploy/agent/seccomp.json) ---
SystemCallArchitectures=native
SystemCallFilter=@system-service bpf perf_event_open
SystemCallFilter=~@mount @module @reboot @swap @obsolete @cpu-emulation @keyring ptrace
SystemCallErrorNumber=EPERM

# --- filesystem / namespace hardening ---
ProtectSystem=strict
ProtectHome=yes
# The L4 plane reads only /sys/kernel/btf (CO-RE). tracefs is root-only on
# systemd distros and L4 no longer needs it (ING-23); the optional entry is
# left for the L7 uprobe path, whose non-root story is decision D-63.
ReadOnlyPaths=/sys/kernel/btf -/sys/kernel/tracing
ReadWritePaths=/var/lib/probectl
# D-43 R2: the policy channel's identity lives here and the agent rotates it
# in place (the certificate is short-lived), so it must be writable.
StateDirectory=probectl-ebpf-agent
StateDirectoryMode=0700
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
