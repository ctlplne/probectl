# probectl all-in-one (deploy/compose/probectl.yml) configuration.
# Copy to `.env` in this directory and edit. Docker Compose loads it automatically.

# --- required for production -------------------------------------------------

# Postgres superuser password for the bundled database. REQUIRED — the stack
# refuses to start while this is empty (SEC-006: no default ships).
# Generate one:  openssl rand -hex 24
# Hex on purpose: the value is spliced into PROBECTL_DATABASE_URL, so it must be
# URL-safe (letters, digits, '.', '_', '~', '-'). A base64 value containing
# '/', '+' or '=' breaks the URL and the control plane refuses to start. The
# preflight (make compose-prod-up) checks this before Compose starts.
POSTGRES_PASSWORD=

# At-rest encryption is ON BY DEFAULT (SEC-002). With PROBECTL_ENVELOPE_KEY
# left empty, the control plane generates a KEK on first boot and persists it
# at PROBECTL_ENVELOPE_KEY_FILE on the `controldata` volume (0600) — back that
# volume up like key material. To supply your own key (recommended for
# production; inject from your KMS/secret manager):
#   openssl rand -base64 32
PROBECTL_ENVELOPE_KEY=
PROBECTL_ENVELOPE_KEY_FILE=/var/lib/probectl/envelope.key
# Tenant artifact object store (browser screenshots/waterfalls, future blobs).
# This path is on the controldata volume in deploy/compose/probectl.yml; encrypt
# the host/volume underneath it as part of your operator at-rest posture.
PROBECTL_OBJECTSTORE_DIR=/var/lib/probectl/objects
# Fail closed (TENANT-106): the control plane refuses to start rather than
# silently writing plaintext when no key resolves. Set false ONLY for a
# throwaway keyless quickstart.
PROBECTL_REQUIRE_AT_REST_ENCRYPTION=true

# NOTE (COMPLY-004): probectl encrypts the values IT manages. Encrypting the
# BULK telemetry volumes (Postgres, ClickHouse, object store) at rest is the
# OPERATOR's duty — dm-crypt/LUKS, ZFS, or encrypted cloud volumes. Verify
# with:  probectl-control preflight --strict   (docs/hardening.md)

# --- TLS ---------------------------------------------------------------------

# Hostnames / IPs the self-signed quickstart certificate is valid for. For a real
# deployment, set this to your public hostname(s) — or bring a CA-issued
# certificate with PROBECTL_TLS_DIR below.
PROBECTL_TLS_HOSTS=localhost,127.0.0.1

# Bring your own certificate (DPR-008): an ABSOLUTE host directory containing
#   tls.crt   the server certificate (with intermediates appended)
#   tls.key   its private key — readable by the container user (uid 65532):
#             chown 65532 tls.key && chmod 600 tls.key
#   ca.crt    the issuing chain (used by curl --cacert examples and dex-demo.yml)
# Empty = the named `certs` volume with the self-signed quickstart certificate.
# certgen keeps a complete bundle untouched and refuses to overwrite a partial one.
PROBECTL_TLS_DIR=

# The stack's Postgres serves TLS (cert from the certgen one-shot) and the
# control plane connects with sslmode=require. Override PROBECTL_DATABASE_URL
# only for dev stacks without TLS — see docs/configuration.md.

# --- license (Enterprise / MSP) ---------------------------------------------

# Absolute path to the offline-signed license file from your vendor. Used by
# the deploy/compose/license.yml overlay (DPR-006):
#   make compose-prod-up PROBECTL_COMPOSE_OVERLAYS='-f deploy/compose/license.yml'
# Empty = Community (the full core, free forever). Verification is local;
# nothing phones home. Admin → Editions shows the loaded tier.
PROBECTL_LICENSE_PATH=

# --- authentication ----------------------------------------------------------

# "session" — real OIDC SSO (the secure default; unauthenticated requests are
#             refused). Set the PROBECTL_OIDC_* values below.
# "dev"     — all-access principal, NO authentication. This is NOT a runtime toggle
#             on this shipped release image: the dev-auth code path only compiles
#             into a binary built with -tags devauth (make build-devauth), which the
#             release image does NOT contain. Set "dev" here and the control plane
#             REFUSES TO START with a clear error (a fatal refusal, not a warning) —
#             and even a devauth build additionally requires PROBECTL_DEV_AUTH_ACK=
#             i-understand AND a loopback-only bind. For a no-IdP local evaluation,
#             use the eval stack (deploy/compose/eval.yml; see docs/getting-started.md),
#             not this production-shaped stack. Never in production.
PROBECTL_AUTH_MODE=session

# OIDC SSO (required when PROBECTL_AUTH_MODE=session).
# Session-token hashes are HMACed before they are stored in Postgres. REQUIRED
# for this production-shaped stack.
# Generate one:  openssl rand -hex 32
PROBECTL_SESSION_HMAC_KEY=

PROBECTL_OIDC_ISSUER=
PROBECTL_OIDC_CLIENT_ID=
PROBECTL_OIDC_CLIENT_SECRET=
PROBECTL_OIDC_REDIRECT_URL=https://localhost:8443/auth/callback

# --- misc --------------------------------------------------------------------

# RFC 9116 disclosure contact served at /.well-known/security.txt.
PROBECTL_SECURITY_CONTACT=mailto:security@your-org.example

# The production compose stack intentionally has NO mutable image default.
# Set an immutable release digest, not just a tag (SUPPLY-001), e.g.:
# PROBECTL_IMAGE=ghcr.io/ctlplne/probectl-control:v0.6.5@sha256:<release-digest>
# If GHCR returns 401, run `docker login ghcr.io` with read:packages access, or
# point at a local/mirrored digest. `make compose-prod-up` runs
# scripts/compose_image_preflight.sh first and prints exact repair commands.
# Tag-only local/mirror refs are allowed only with this explicit acknowledgement:
# PROBECTL_ALLOW_TAG_IMAGE=i-understand-this-is-mutable
