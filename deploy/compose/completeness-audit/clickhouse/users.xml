<clickhouse>
  <!-- The entrypoint-created `probectl` user inherits this profile. Defining
       the custom setting here makes getSetting() fail closed to an empty
       tenant before any request supplies its per-query tenant value. -->
  <profiles>
    <default>
      <!-- ClickHouse custom settings use the serialized Field syntax. Two
           single quotes are the typed String representation of an empty
           value; an empty XML node has no type and makes 24.8 fail startup. -->
      <SQL_probectl_tenant>''</SQL_probectl_tenant>
    </default>
  </profiles>
  <!-- DPR-285: the SELECT-only reader every tenant read runs as. The product
       binds its setting-scoped row policy to this login and proves at boot
       that it cannot write and that the policy binds it. SELECT on the pooled
       `default` database only; the password comes from the environment. -->
  <users>
    <probectl_reader>
      <password from_env="CLICKHOUSE_READER_PASSWORD"/>
      <profile>default</profile>
      <quota>default</quota>
      <networks><ip>::/0</ip></networks>
      <grants><query>GRANT SELECT ON default.*</query></grants>
    </probectl_reader>
  </users>
</clickhouse>
