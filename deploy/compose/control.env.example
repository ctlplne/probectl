# Optional extra control-plane configuration for deploy/compose/probectl.yml.
# Copy to `control.env` in this directory (never committed) and add any
# PROBECTL_* key from docs/configuration.md that probectl.yml does not already
# set. The keys probectl.yml sets explicitly (TLS, database, envelope, session,
# auth mode, OIDC, log format) always win over this file.
#
# First provider operator on a licensed MSP deployment (docs/provider-plane.md):
# PROBECTL_PROVIDER_BOOTSTRAP_TOKEN=<openssl rand -hex 32>
#
# Deployment profile (single | multi-tenant | regulated; docs/hardening.md):
# PROBECTL_DEPLOYMENT_PROFILE=single
#
# Verbosity:
# PROBECTL_LOG_LEVEL=info
