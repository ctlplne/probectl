# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89
# Optional W1 sidecar: Python BGP analyzer + the tenant-bound Go bus bridge.
# Build context is the repository root.

ARG GO_VERSION=1.26.5
ARG PYTHON_VERSION=3.12.10

FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651 AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=0.0.0-dev
ARG COMMIT=unknown
ARG DATE=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN --mount=type=cache,target=/root/.cache/go-build \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} CGO_ENABLED=0 \
    go build -trimpath \
      -ldflags "-s -w \
        -X github.com/ctlplne/probectl/internal/version.Version=${VERSION} \
        -X github.com/ctlplne/probectl/internal/version.Commit=${COMMIT} \
        -X github.com/ctlplne/probectl/internal/version.Date=${DATE}" \
      -o /out/probectl-control ./cmd/probectl-control

# Multi-arch manifest digest, resolved 2026-07-14. Python is an established
# project stack component; the exact digest + hash-locked wheel keep this
# optional runtime reproducible.
FROM python:${PYTHON_VERSION}-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db
COPY analyzer/requirements.lock /tmp/requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock \
    && rm /tmp/requirements.lock
COPY --from=build /out/probectl-control /usr/local/bin/probectl-control
COPY --chown=65532:65532 analyzer/probectl_analyzer /opt/probectl/analyzer/probectl_analyzer
RUN chmod -R a+rX /opt/probectl/analyzer \
    && PYTHONPATH=/opt/probectl/analyzer python -c "import probectl_analyzer"
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/probectl/analyzer
WORKDIR /opt/probectl/analyzer
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/probectl-control", "bgp-analyzer"]
