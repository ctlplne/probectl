# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89
# Rendered-browser agent: the static Go canary runtime plus the existing
# listener-free Playwright worker in one process namespace/image.

ARG GO_VERSION=1.26.10

FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=0.0.0-dev
ARG COMMIT=unknown
ARG DATE=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN --mount=type=cache,target=/root/.cache/go-build \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} CGO_ENABLED=0 \
    go build -trimpath \
      -ldflags "-s -w \
        -X github.com/ctlplne/probectl/internal/version.Version=${VERSION} \
        -X github.com/ctlplne/probectl/internal/version.Commit=${COMMIT} \
        -X github.com/ctlplne/probectl/internal/version.Date=${DATE}" \
      -o /out/probectl-agent ./cmd/probectl-agent

# Chromium + OS runtime are supplied by the already-pinned Playwright image.
FROM mcr.microsoft.com/playwright:v1.55.1-noble@sha256:2f29369043d81d6d69a815ceb80760f55e85f5020371ad06a4d996f18503ad1c
WORKDIR /worker
# DPR-062: explicit modes — COPY otherwise inherits the build host's file
# modes, and a 0600 checkout produced a worker the chart's uid could not read
# (every rendered transaction failed with EACCES).
COPY --chmod=0644 browser-worker/package.json browser-worker/package-lock.json ./
# The worker runs on plain node; no package manager is needed at runtime. The
# base image's global npm bundles its own (vulnerable, CVE-2026-59873) tar, and
# corepack/yarn fetch package managers from the network, so all three leave the
# runtime image once the worker's dependencies are installed (PD-13).
RUN npm ci --omit=dev --no-audit --no-fund && chmod -R a+rX /worker && \
    rm -rf /usr/lib/node_modules/npm /usr/lib/node_modules/corepack /usr/lib/node_modules/yarn \
      /usr/bin/npm /usr/bin/npx /usr/bin/corepack /usr/bin/yarn /usr/bin/yarnpkg /root/.npm && \
    sh -c '! command -v npm && ! command -v npx && ! command -v corepack && ! command -v yarn'
COPY --chown=pwuser:pwuser --chmod=0644 browser-worker/worker.mjs ./worker.mjs
COPY --from=build --chmod=0755 /out/probectl-agent /usr/local/bin/probectl-agent
RUN node --check /worker/worker.mjs && test -r /worker/worker.mjs

ENV PROBECTL_AGENT_BROWSER_DRIVER=browser \
    PROBECTL_AGENT_BROWSER_WORKER_COMMAND=node \
    PROBECTL_AGENT_BROWSER_WORKER_PATH=/worker/worker.mjs
USER pwuser
ENTRYPOINT ["/usr/local/bin/probectl-agent"]
