# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89
#
# probectl-ebpf-agent — the LIVE (-tags ebpf) image (EBPF-004).
#
# The generic deploy/docker/Dockerfile builds plain Go binaries; built that
# way, probectl-ebpf-agent would be the FIXTURE-ONLY replayer (dev/test
# mode). The shipped agent image must carry the live CO-RE loader, so this
# Dockerfile runs the same toolchain operators use (`make ebpf-agent`):
# bpf2go (clang) compiles the BPF objects for BOTH target arches, gendigests
# bakes the U-014 SHA-256 manifest, and the Go build embeds objects +
# manifest under -tags ebpf. The ci.yml `ebpf-image-live` job asserts the
# built image's binary really records the tag — a fixture image can't ship
# unnoticed.
#
# Build-host requirement: /sys/kernel/btf/vmlinux must be readable in the
# build container (any BTF kernel — GitHub runners and Docker Desktop
# qualify); vmlinux.h is generated from it, CO-RE relocates at load time on
# the deployment kernel.

ARG GO_VERSION=1.26.5

# Digest-pinned (U-061); bumped manually per docs/dependency-policy.md (no
# auto-update bot). Tag kept for humans.
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651 AS ebpf-toolchain
ARG GO_VERSION=1.26.5

# clang compiles the BPF objects; bpftool dumps the build host's BTF → vmlinux.h.
# The libbpf BPF headers are vendored (internal/ebpf/bpf/headers, -I'd into bpf2go
# below), so NO libbpf-dev: the compile is independent of the distro's libbpf
# version. (bookworm's libbpf 1.1 lacked BPF_UPROBE — the exact break this fixes;
# see internal/ebpf/bpf/headers/VENDOR.md.)
# SUPPLY-003: the compiler path is pinned at three layers:
#   1. digest-pinned Go/Debian base image,
#   2. immutable signed Debian snapshot timestamp,
#   3. exact clang/llvm/bpftool package versions.
ARG DEBIAN_SNAPSHOT=20260702T000000Z
ARG CLANG_14_VERSION=1:14.0.6-12
ARG LLVM_14_VERSION=1:14.0.6-12
ARG BPFTOOL_VERSION=7.1.0+6.1.174-1
RUN set -eux; \
    printf '%s\n' \
      "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm main" \
      "deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT} bookworm-security main" \
      > /etc/apt/sources.list; \
    rm -f /etc/apt/sources.list.d/*; \
    apt-get -o Acquire::Check-Valid-Until=false update -q; \
    apt-get install -y -q --no-install-recommends \
      "clang-14=${CLANG_14_VERSION}" \
      "llvm-14=${LLVM_14_VERSION}" \
      "bpftool=${BPFTOOL_VERSION}"; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /usr/local/share/probectl; \
    { \
      echo "base=golang:${GO_VERSION}-bookworm@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651"; \
      echo "debian_snapshot=${DEBIAN_SNAPSHOT}"; \
      echo "clang-14=${CLANG_14_VERSION}"; \
      echo "llvm-14=${LLVM_14_VERSION}"; \
      echo "bpftool=${BPFTOOL_VERSION}"; \
    } > /usr/local/share/probectl/ebpf-toolchain.txt
ENV CLANG=clang-14 \
    BPFTOOL=bpftool

FROM ebpf-toolchain AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=0.0.0-dev
ARG COMMIT=unknown
ARG DATE=unknown
WORKDIR /src

# Cache dependencies first for faster rebuilds.
COPY go.mod go.sum ./
RUN go mod download

COPY . .
# The operator build path (mirrors `make ebpf-agent` + the kernel-matrix CI
# job): vmlinux.h from the build host's BTF, bpf2go for both objects (the
# uprobe object is per-arch; clang cross-compiles BPF regardless of build
# platform), then the U-014 digest manifest.
RUN test -r /sys/kernel/btf/vmlinux || { echo "build host kernel has no BTF (/sys/kernel/btf/vmlinux) — required to generate vmlinux.h"; exit 1; }
RUN --mount=type=cache,target=/root/.cache/go-build \
    set -eux; \
    bpftool btf dump file /sys/kernel/btf/vmlinux format c > internal/ebpf/bpf/vmlinux.h; \
    # Single source of truth for the bpf2go compile. sslsniff builds for the
    # image's target arch (${TARGETARCH}); gen_bpf.sh auto-detects whether this
    # build host's vmlinux.h already has struct user_pt_regs and sets the
    # arch_compat opt-out accordingly (here it's an amd64 host, so the arm64
    # image is a cross-build and the shim is needed → opt-out NOT set).
    (cd internal/ebpf && bash gen_bpf.sh all "${TARGETARCH}"); \
    (cd internal/ebpf && go run ./gendigests .); \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} CGO_ENABLED=0 \
    go build -trimpath -tags ebpf \
      -ldflags "-s -w \
        -X github.com/ctlplne/probectl/internal/version.Version=${VERSION} \
        -X github.com/ctlplne/probectl/internal/version.Commit=${COMMIT} \
        -X github.com/ctlplne/probectl/internal/version.Date=${DATE}" \
      -o /out/app ./cmd/probectl-ebpf-agent

# Minimal, non-root runtime. The agent needs CAP_BPF + CAP_PERFMON granted by
# the orchestrator (see deploy/agent/probectl-ebpf-agent.service and the Helm
# chart) — the image itself stays nonroot.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:d093aa3e30dbadd3efe1310db061a14da60299baff8450a17fe0ccc514a16639
LABEL org.opencontainers.image.source="https://github.com/ctlplne/probectl" \
      org.opencontainers.image.title="probectl-ebpf-agent" \
      org.opencontainers.image.description="probectl eBPF host agent (live CO-RE loader, observe-only)"
COPY --from=build /out/app /usr/local/bin/app
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/app"]
