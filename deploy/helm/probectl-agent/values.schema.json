{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "allowTagOnly": {
          "type": "boolean"
        },
        "pullPolicy": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "allowTagOnly": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "tag": {
                "pattern": "@sha256:[A-Fa-f0-9]{64}$"
              }
            },
            "required": [
              "tag"
            ]
          }
        }
      ]
    },
    "admission": {
      "type": "object",
      "properties": {
        "imageIntegrity": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "acceptedRisk": {
              "type": "string"
            },
            "policyName": {
              "type": "string",
              "minLength": 1
            },
            "validationFailureAction": {
              "type": "string",
              "enum": [
                "Enforce",
                "Audit"
              ]
            },
            "background": {
              "type": "boolean"
            },
            "imageReferences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "issuer": {
              "type": "string",
              "format": "uri"
            },
            "subjectRegExp": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "capabilityPosture": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "policyName": {
              "type": "string",
              "minLength": 1
            },
            "validationFailureAction": {
              "type": "string",
              "enum": [
                "Enforce",
                "Audit"
              ]
            },
            "background": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "tenantID": {
      "type": "string"
    },
    "agentID": {
      "type": "string",
      "description": "The registered collector identity (agent_id) every record carries (DPR-051). Required: rendering fails closed without it."
    },
    "bus": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "kafka",
            "memory"
          ]
        },
        "brokers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,62})?$|^$",
          "description": "The tenant's bus lane, t-<tenant-slug> (DPR-049)."
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "clientAuth": {
              "type": "boolean"
            }
          }
        },
        "sasl": {
          "type": "object",
          "properties": {
            "mechanism": {
              "type": "string",
              "enum": [
                "",
                "plain",
                "scram-sha-256",
                "scram-sha-512"
              ]
            },
            "existingSecret": {
              "type": "string"
            },
            "userKey": {
              "type": "string",
              "minLength": 1
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allowPlaintext": {
          "type": "boolean"
        }
      }
    },
    "l7Capture": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "consentTenant": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(pid:[0-9]+|exe:/.*|cgroup:/.*)$"
          }
        },
        "hostRoot": {
          "type": "string",
          "pattern": "^(|/.*)$"
        },
        "hostLibraryPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/.+$"
          }
        },
        "redaction": {
          "type": "string",
          "enum": [
            "headers",
            "length",
            "full"
          ]
        },
        "kernelWindow": {
          "type": "integer",
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 128,
              "maximum": 4095
            }
          ]
        },
        "ringBufferBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "identityHeaderFragments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hashAllHeaderValues": {
          "type": "boolean"
        }
      }
    },
    "capabilityMode": {
      "type": "string",
      "enum": [
        "modern",
        "legacy"
      ]
    },
    "legacyKernelRingBufferAck": {
      "type": "string"
    },
    "ringBufferBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 268435456
    },
    "maxBatchBytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 8388608
    },
    "health": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "exec",
            "http"
          ]
        },
        "stateDir": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "allowPlaintextHTTP": {
          "type": "boolean"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "bindAddress": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "tls": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        }
      }
    },
    "tracefs": {
      "type": "object",
      "properties": {
        "hostPath": {
          "type": "string",
          "pattern": "^/"
        }
      }
    }
  }
}
