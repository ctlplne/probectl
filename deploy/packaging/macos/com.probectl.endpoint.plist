<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.probectl.endpoint</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/probectl Endpoint.app/Contents/MacOS/probectl-endpoint</string>
        <string>--managed</string>
    </array>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
