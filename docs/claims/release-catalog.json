    {
      "id": "CLM-NO-PHONE-HOME",
      "kind": "capability",
      "owner": "release/docs",
      "title": "No default outbound telemetry, beacon, or phone-home exists; telemetry never leaves the operator's network by default."
    },
    {
      "id": "CLM-AIR-GAP",
      "kind": "capability",
      "owner": "release/docs",
      "title": "The deployment operates air-gapped: the default AI is the in-process builtin and no feature requires egress."
    },
    {
      "id": "CLM-FAIL-CLOSED",
      "kind": "capability",
      "owner": "release/docs",
      "title": "Missing channel security, credential, signature, tenant binding, or license state degrades closed, never open."
    },
    {
      "id": "CLM-TAMPER-EVIDENT",
      "kind": "capability",
      "owner": "release/docs",
      "title": "Audit streams are hash-chained and tamper-evident."
    },
    {
      "id": "CLM-OBSERVE-ONLY",
      "kind": "capability",
      "owner": "release/docs",
      "title": "Collection and detection observe; nothing mutates the observed network (eBPF observe-only, no remediation executor)."
    },
    {
      "id": "CLM-HUMAN-GATED",
      "kind": "capability",
      "owner": "release/docs",
      "title": "Remediation is human-gated: explicit approval, dry-run, blast-radius limits; never autonomous."
    },
    {
      "id": "CLM-NOT-AN-IPS",
      "kind": "capability",
      "owner": "release/docs",
      "title": "Detection is a confidence-scored signal, never inline blocking / an IPS."
    },
    {
      "id": "CLM-STORAGE-LAYER-TENANCY",
      "kind": "capability",
      "owner": "release/docs",
      "title": "Tenant isolation is enforced at the storage layer (FORCE RLS / partition / silo), not per-handler."
    },
    {
      "id": "CLM-HONEST-NUMBERS",
      "kind": "capability",
      "owner": "release/docs",
      "title": "Numbers are labeled illustrative/reference/smoke; guarantee language is bounded to what is measured or explicitly negated."
    },
    {
      "id": "CLM-SEP-AUDITED",
      "kind": "capability",
      "owner": "release/docs",
      "title": "Provider/break-glass operations are separately audited from tenant streams."
    },
    {
      "id": "CLM-CONSENT-GATED",
      "kind": "capability",
      "owner": "release/docs",
      "title": "Remote AI egress requires explicit tenant consent and redaction; denial is the default."
    },
    {
      "id": "CLM-BGP-FEEDS",
      "kind": "capability",
      "owner": "release/docs",
      "title": "The analyzer fetches only RPKI VRP data (read-only, validated TLS, per-run, no on-disk cache; failure degrades to RPKI unknown); collector MRT archives are bring-your-own local artifacts with no fetching or decompression; RIS Live reads RIPE's public websocket."
    },
    {
      "id": "CLM-EBPF-INTEGRITY",
      "kind": "capability",
      "owner": "release/docs",
      "title": "The embedded BPF object digest proves generator freshness and binary self-consistency (mismatch refuses to load, fail closed); tamper protection for the shipped artifact is the cosign release signature over objects + manifest + binary together."
    },
    {
      "id": "CLM-INGEST-SCOPE",
      "kind": "capability",
      "owner": "release/docs",
      "title": "Open-data/threat feeds are ingested once (shared) then scoped per tenant; BGP collector ingestion runs per tenant by decision of record (ADR bgp-ingest-model), with the shared fan-out as a recorded scaling boundary."
    },
